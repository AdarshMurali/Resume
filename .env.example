# ---------------------------------------------------------------------------
# Environment variables. Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets. Only this example file is tracked.
#
# In Vite, ONLY variables prefixed with `VITE_` are exposed to the browser.
# The OpenAI key must NOT have that prefix — it is read server-side inside
# api/chat.ts so it never ships to the client.
# In Vercel, add the same keys under Project → Settings → Environment Variables
# for both Production and Preview.
# ---------------------------------------------------------------------------

# --- Server-only (chatbot) --------------------------------------------------
# OpenAI API key used by api/chat.ts. Server-only. Do NOT prefix with VITE_.
OPENAI_API_KEY=

# Optional: override the model used by the chatbot (see docs/CHATBOT.md).
# Default is gpt-4o-mini — cheap/fast, plenty for grounded resume Q&A.
# OPENAI_MODEL=gpt-4o-mini

# --- Public (safe to expose to the browser; must be VITE_-prefixed) ---------
# Canonical site URL, used for OG/Twitter meta tags and JSON-LD.
VITE_SITE_URL=https://your-domain.example

# GitHub username used to fetch featured repo stats (build-time or client-side).
VITE_GITHUB_USERNAME=AdarshMurali

# Public profile links (also duplicated as typed data in src/content/links.ts —
# that file is the source of truth for the UI; these exist for build scripts /
# scripts/build-knowledge.ts convenience).
VITE_LINKEDIN_URL=https://www.linkedin.com/in/adarsh-murali-93252450/
VITE_TABLEAU_PUBLIC_URL=https://public.tableau.com/app/profile/adarsh.m5164/viz/AdarshMuraliResume2026/AdarshResume

# Optional: privacy-friendly analytics (leave blank to disable).
# VITE_PLAUSIBLE_DOMAIN=
